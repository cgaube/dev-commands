    "@inkjs/ui": "^2.0.0",
    "@tanstack/react-query": "^5.103.2",
    "colorize-template": "^1.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react-devtools-core": "^8.0.0"
  }
}
