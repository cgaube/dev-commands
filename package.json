{
  "name": "commands-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "ts:check": "bun run --workspaces ts:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:check": "oxlint --deny-warnings .",
    "lint": "bun run lint:check --fix",
    "compile": "bun run --filter './packages/*' compile && bun run cleanup",
    "cleanup": "rm -f packages/*/.*.bun-build",
    "update:dependencies": "bun update -i -r"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
