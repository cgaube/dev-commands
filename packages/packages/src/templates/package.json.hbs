{
  "name": "{{packageName}}",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun",
  "scripts": {
    "{{packageName}}": "bun run src/main.ts",
    "compile": "bun run ts:check && bun build src/main.ts --compress --compile --outfile {{outputDir}}/{{packageName}}",
    "compile:watch": "bun run compile --watch",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
