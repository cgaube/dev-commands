    "ts:check": "tsc --noEmit",
    "icons": "bun scripts/icon-preview.tsx"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@tanstack/react-query": "^5.104.5",
    "colorize-template": "^1.0.0",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react-devtools-core": "^8.0.0"
  }
}
