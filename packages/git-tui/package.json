{
  "name": "@devcommands/git-tui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "git-tui": "bun run src/main.ts",
    "compile": "bun run ts:check && bun build src/main.ts --compress --compile --outfile bin/git-tui",
