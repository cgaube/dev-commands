{
  "name": "commands-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "ts:check": "bun run --workspaces ts:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:check": "eslint --cache --max-warnings 0 .",
    "lint": "bun run lint:check --fix",
    "build": "bun run --workspaces build",
    "compile": "bun run --workspaces compile && bun run cleanup",
    "cleanup": "rm -f packages/*/.*.bun-build",
    "update:dependencies": "bun update -i -r"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
